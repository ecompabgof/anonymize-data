{
  "description": "anonymize-data : bloque les documents clients originaux avant qu'ils n'atteignent Claude",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/guard/guard.py\" prompt || exit 2",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|NotebookRead|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/guard/guard.py\" tool || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
